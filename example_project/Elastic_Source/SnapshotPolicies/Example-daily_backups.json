{
  "Example-daily_backups": {
    "schedule": "0 0 1 * * ?",
    "name": "<example-daily_backups-{now/d}>",
    "repository": "found-snapshots",
    "config": {
      "indices": [
        ".kibana-*"
      ],
      "feature_states": [],
      "ignore_unavailable": true,
      "include_global_state": false,
      "partial": true
    },
    "retention": {
      "expire_after": "7d",
      "min_count": 7,
      "max_count": 10
    }
  }
}
